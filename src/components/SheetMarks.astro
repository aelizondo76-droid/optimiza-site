---
// Marcas de hoja técnica: esquinas de registro + rótulo de hoja.
// Convierten el hero en una lámina de plano — profundidad sin oscuridad.
// Uso: dentro de una sección con position:relative.
interface Props { label?: string; top?: number }
const { label, top = 78 } = Astro.props;
---
<div class="sheet" aria-hidden="true" style={`--sheet-top:${top}px`}>
  <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  {label && <span class="sheet-label">{label}</span>}
</div>

<style>
  .sheet { position: absolute; inset: var(--sheet-top, 16px) 18px 16px; pointer-events: none; }
  .sheet .c { position: absolute; width: 12px; height: 12px; border: 0 solid var(--line-strong); opacity: 0.55; }
  .sheet .tl { top: 0; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
  .sheet .tr { top: 0; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
  .sheet .bl { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .sheet .br { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }
  .sheet-label { position: absolute; top: -3px; right: 24px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  @media (max-width: 640px) { .sheet-label { display: none; } .sheet { inset: var(--sheet-top, 16px) 12px 12px; } }
</style>
