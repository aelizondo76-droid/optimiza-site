---
import Base from '../layouts/Base.astro';
import Scanner from '../components/Scanner.astro';
import RegistroCinta from '../components/RegistroCinta.astro';
import SheetMarks from '../components/SheetMarks.astro';
import { getSeo } from '../lib/seo';
import { founderProgramSlots } from '../lib/founderProgram';
const founder = founderProgramSlots();
const seo = await getSeo('home', {
  title: 'Optimiza — Optimización de negocios a través de tu web',
  description: 'No solo optimizamos tu web: optimizamos tu negocio a través de ella. Analiza tu sitio al instante y descubre dónde pierdes ventas — y cuánto puedes recuperar.',
});
const title = seo.title;
const description = seo.description;

// AEO: mismas preguntas/respuestas visibles en la sección #faq, también expuestas como FAQPage.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuánto cuesta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El diagnóstico es gratis. A partir de ahí, cada nivel tiene un precio claro según el alcance — Cimientos es un proyecto puntual, Aceleración y Autopilot son mensuales. Sin sorpresas ni letras chiquitas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Trabajan con mi plataforma?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí: WordPress, Shopify, Webflow, sitios a medida y más. El diagnóstico detecta tu stack automáticamente y adaptamos el plan a lo que ya tienes.',
      },
    },
  ],
};
---
<Base title={title} description={description} ogImage={seo.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="hero section hero-data dark portada">
    <svg class="ondas" viewBox="0 0 1440 820" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path d="M0 560 C300 480 560 640 880 560 C1140 496 1300 560 1440 500 L1440 820 L0 820 Z" fill="#F1F0E9" fill-opacity="0.045"/>
      <path d="M0 640 C280 550 540 700 880 620 C1150 558 1310 630 1440 570 L1440 820 L0 820 Z" fill="#2E7A55" fill-opacity="0.22"/>
      <path d="M0 726 C320 640 640 780 960 706 C1200 652 1330 716 1440 672 L1440 820 L0 820 Z" fill="#963A1D" fill-opacity="0.30"/>
      <path d="M0 788 C360 720 700 830 1040 770 C1260 732 1360 774 1440 744 L1440 820 L0 820 Z" fill="#0C1410" fill-opacity="0.55"/>
      <g fill="none" stroke="#F1F0E9" stroke-opacity="0.16" stroke-width="1">
        <path d="M0 520 C300 440 560 600 880 520 C1140 456 1300 520 1440 460"/>
        <path d="M0 496 C300 416 560 576 880 496 C1140 432 1300 496 1440 436"/>
      </g>
    </svg>
    <SheetMarks label="Optimiza · Índice 2026 · Hoja 01" />
    <div class="hero-cinta"><RegistroCinta /></div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Índice Optimiza · Costa Rica 2026</p>
          <h1 class="hero-title">Tu competidor que empiece a <em class="medido">medir</em> su web, te va a vencer.</h1>
          <p class="hero-lead">No importará su tamaño. Importará su estrategia web. Analiza la tuya ahora mismo — el mismo escáner que usamos para medir 346 empresas costarricenses.</p>
          <div class="hero-cta-row">
            <a class="btn btn-ghost" href="#metodo">Ver cómo trabajamos</a>
          </div>
        </div>
        <div class="hero-instrument">
          
          <Scanner />
          <p class="hero-sub">Sin registro para ver tu puntaje · el instrumento llega encendido con nuestra propia lectura.</p>
        </div>
      </div>

      <dl class="ledger-row" aria-label="Estado digital de las empresas en Costa Rica, 2026">
        <div class="lg-cell">
          <dt class="lg-l">sitios analizados</dt>
          <dd class="lg-n">346</dd>
        </div>
        <div class="lg-cell lg-crit">
          <dt class="lg-l">sin Meta Pixel</dt>
          <dd class="lg-n">66%</dd>
          <div class="regla" style="--val:66; --sig:var(--crit)" role="img" aria-label="66 por ciento, en una escala de 0 a 100"><i class="aguja"></i></div>
        </div>
        <div class="lg-cell lg-crit">
          <dt class="lg-l">pérdida anual estimada</dt>
          <dd class="lg-n">$82M</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section statband">
    <div class="wrap">
      <div class="sb-grid">
        <div class="sb-reading">
          <div class="sb-num" aria-hidden="true">66<small>%</small></div>
          <div class="regla sb-regla" style="--val:66; --sig:var(--crit)" role="img" aria-label="66 por ciento de las empresas, en una escala de 0 a 100"><i class="aguja"></i></div>
          <div class="sb-scale" aria-hidden="true"><span>0</span><span>50</span><span>100</span></div>
        </div>
        <div class="sb-claim">
          <p class="big">de las empresas no puede ver quién visita su web, ni volver a contactarlo. <em>Eso es lo que de verdad cuesta ventas</em> — no un segundo más de carga.</p>
          <p class="src">Fuente: Índice Optimiza · 346 sitios analizados, Costa Rica 2026</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pilares">
    <div class="wrap">
      <div class="shead">
        <h2>Todo lo que tu web necesita para vender, en un solo lugar.</h2>
        <p class="lead">Nuestra optimización web se apoya en cuatro palancas que trabajan juntas: atraer, cargar rápido, convertir y automatizar. No vendemos tareas técnicas — vendemos el resultado de negocio de cada una.</p>
      </div>
      <div class="pillar-index">
        <a class="pi-row" href="/servicios/#velocidad">
          <h3 class="pi-name">Velocidad</h3>
          <p class="pi-hook">&ldquo;Cada segundo cuesta ventas.&rdquo;</p>
          <p class="pi-desc">Core Web Vitals, compresión de imágenes y código limpio para que tu web cargue al instante.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#visibilidad">
          <h3 class="pi-name">Visibilidad</h3>
          <p class="pi-hook">&ldquo;Que te encuentren primero.&rdquo;</p>
          <p class="pi-desc">SEO técnico, contenido y optimización para IA — para que aparezcas antes que tu competencia.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#conversion">
          <h3 class="pi-name">Conversión</h3>
          <p class="pi-hook">&ldquo;Convierte tráfico en clientes.&rdquo;</p>
          <p class="pi-desc">Landing pages, medición y pruebas A/B para que las visitas que ya tienes se vuelvan ventas.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#automatizacion">
          <h3 class="pi-name">Automatización</h3>
          <p class="pi-hook">&ldquo;Que tu negocio trabaje sin ti.&rdquo;</p>
          <p class="pi-desc">CRM, integraciones y flujos que convierten tu crecimiento en tiempo libre recuperado.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="metodo">
    <div class="wrap">
      <div class="method-grid">
        <div class="method-col">
          <div class="shead">
            <h2>Sin cajas negras.</h2>
            <p class="lead">Un proceso claro, en cuatro pasos, donde cada acción se justifica por su impacto en ventas — no por horas facturadas.</p>
          </div>
          <ol class="timeline">
            <li><span class="step-n" aria-hidden="true">01</span><div><div class="sn">Diagnosticamos</div><p>Auditoría técnica completa de velocidad, SEO y conversión.</p></div></li>
            <li><span class="step-n" aria-hidden="true">02</span><div><div class="sn">Priorizamos</div><p>Ordenamos cada mejora por impacto en tus ventas, no por dificultad.</p></div></li>
            <li><span class="step-n" aria-hidden="true">03</span><div><div class="sn">Ejecutamos</div><p>Implementamos rápido, con reportes claros en cada paso.</p></div></li>
            <li><span class="step-n" aria-hidden="true">04</span><div><div class="sn">Medimos</div><p>Reportamos resultados en la métrica que importa: dinero.</p></div></li>
          </ol>
        </div>

        <div class="method-col" id="paquetes">
          <div class="shead">
            <h2>Empieza donde estás. Escala cuando estés listo.</h2>
            <p class="lead">Una escalera clara: entra por un diagnóstico gratis y sube de nivel solo cuando el anterior ya te esté generando resultados.</p>
          </div>
          <div class="ladder-v">
            <article class="rung-v free"><div class="rv-top"><span class="lvl">Paso 0</span><span class="kind">Gratis</span></div><h3>Diagnóstico</h3><p class="for">Descubre qué te frena y cuánto puedes ganar.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 1</span><span class="kind">Proyecto</span></div><h3>Cimientos</h3><p class="for">Para que tu web deje de perder ventas: base técnica sólida.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 2</span><span class="kind">Retainer</span></div><h3>Aceleración</h3><p class="for">Para crecer ventas mes a mes: tráfico y conversión.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 3</span><span class="kind">Premium</span></div><h3>Autopilot</h3><p class="for">Para que el crecimiento no dependa de ti: automatización total.</p></article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section firma" id="fundador">
    <div class="wrap">
      <div class="firma-grid">
        <img class="firma-foto" src="/founder/alonso-elizondo.jpg" alt="Alonso Elizondo, fundador de Optimiza" width="480" height="480" loading="lazy" />
        <div class="firma-body">
          <h2>Quién firma cada informe.</h2>
          <p class="firma-nombre">Alonso Elizondo</p>
          <p class="firma-cred">Economista. Director Ejecutivo de la Cámara de Comercio de Costa Rica durante 18 años (2006–2024).</p>
          <p class="firma-linea">La misma disciplina con la que se mide una economía, aplicada a tu web: cada recomendación sale de un dato, y cada resultado se reporta en la métrica que te importa — ventas.</p>
          <a class="btn btn-ghost" href="/nosotros/">Conoce cómo trabajamos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(80px,11vw,130px)">
    <div class="wrap">
      <div class="founder-band">
        <div class="fb-grid">
          <div>
            <h2 style="font-size:clamp(26px,4vw,40px)">5 empresas. Precio de fundador. Resultados garantizados.</h2>
            <p class="lead" style="margin-top:14px">Buscamos cinco negocios en crecimiento para trabajar de cerca a cambio de precio preferente y un caso de éxito compartido. Entra temprano en algo bueno.</p>
            <div class="fb-slots" aria-hidden="true" set:html={founder.dotsHtml} />
            <p class="fb-count">{founder.label}</p>
            <div class="hero-cta-row"><a class="btn btn-violet" href="/contacto/">Aplicar al Programa Fundador</a></div>
          </div>
          <div class="fb-guarantee">
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Precio fundador, congelado mientras seas cliente.</span></div>
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Sin amarres: mes a mes, cancelas cuando quieras.</span></div>
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Atención directa del fundador, no de un becario.</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section closer" id="faq">
    <div class="wrap">
      <div class="closer-grid">
        <div>
          <h2>Lo que probablemente te estás preguntando.</h2>
          <div class="faq">
            <div class="qa"><button class="q" aria-expanded="false">¿Cuánto cuesta?<span class="ic" aria-hidden="true"></span></button><div class="a"><p>El diagnóstico es gratis. A partir de ahí, cada nivel tiene un precio claro según el alcance — Cimientos es un proyecto puntual, Aceleración y Autopilot son mensuales. Sin sorpresas ni letras chiquitas.</p></div></div>
            <div class="qa"><button class="q" aria-expanded="false">¿Trabajan con mi plataforma?<span class="ic" aria-hidden="true"></span></button><div class="a"><p>Sí: WordPress, Shopify, Webflow, sitios a medida y más. El diagnóstico detecta tu stack automáticamente y adaptamos el plan a lo que ya tienes.</p></div></div>
          </div>
        </div>

        <div class="closer-cta">
          <h2>¿Listo para ver cuánto puede crecer tu web?</h2>
          <div class="cta-row">
            <a class="btn btn-violet" href="#scanner">Analizar mi web gratis</a>
            <a class="btn btn-ghost" href="/contacto/">Agenda una llamada</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: papel claro; el único objeto oscuro es el instrumento (Scanner). */
  .hero-data.portada { overflow: hidden; padding-top: clamp(84px, 8vw, 100px); padding-bottom: clamp(130px, 15vw, 170px);
    background:
      linear-gradient(rgba(241,240,233,0.028) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(90deg, rgba(241,240,233,0.028) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(168deg, #16241D 0%, #101B15 46%, #0C1410 100%); }
  .ondas { position: absolute; inset: auto 0 0 0; width: 100%; height: 72%; z-index: 0; pointer-events: none; }
  .portada .wrap, .portada .hero-cinta { position: relative; z-index: 1; }
  .portada :global(.scanner) { border-color: rgba(241,240,233,0.14); box-shadow: 0 1px 2px rgba(0,0,0,0.4), 0 18px 44px -14px rgba(0,0,0,0.6); }
  .portada .ledger-row { border-top-color: rgba(241,240,233,0.4); }
  .hero-cinta { margin-bottom: clamp(36px, 5vw, 54px); }
  @media (max-width: 940px) {
    .hero-data { padding-top: 68px; padding-bottom: 120px; }
    .hero-data :global(.sheet) { --sheet-top: 118px; }
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (max-width: 940px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  h1.hero-title { font-size: clamp(34px, 4.2vw, 54px); margin-bottom: 20px; overflow-wrap: anywhere; min-width: 0; }
  /* La palabra medida: subrayado de regleta — tipografía como instrumento. */
  .medido { font-style: normal; position: relative; white-space: nowrap; padding-bottom: 2px;
    background-image:
      linear-gradient(var(--crit) 0 0),
      repeating-linear-gradient(90deg, var(--crit) 0 1.5px, transparent 1.5px 14.28%);
    background-size: 100% 2px, calc(100% + 1.5px) 7px;
    background-position: bottom left, bottom left;
    background-repeat: no-repeat, no-repeat; }
  .hero-lead { color: var(--muted); font-size: clamp(16px, 1.7vw, 18px); max-width: 46ch; }
  .hero-instrument { min-width: 0; position: relative; }
  .hero-instrument :global(.scanner) { z-index: 1; }
  .hero-sub { font-size: 12.5px; color: var(--faint); margin-top: 14px; }

  /* Regleta-ledger: renglón de lecturas del informe. */
  .ledger-row { display: flex; flex-wrap: wrap; gap: 0; margin: clamp(44px, 6vw, 68px) 0 0; border-top: 1.5px solid var(--line-strong); }
  .lg-cell { flex: 1; min-width: 180px; padding: 18px 28px 4px 0; display: flex; flex-direction: column; gap: 4px; }
  .lg-cell + .lg-cell { padding-left: 28px; border-left: 1px solid var(--line); }
  @media (max-width: 620px) { .lg-cell + .lg-cell { border-left: none; padding-left: 0; } .lg-cell { min-width: 100%; padding-right: 0; } }
  .lg-cell dt, .lg-cell dd { margin: 0; }
  .lg-l { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: 0.08em; text-transform: uppercase; order: 1; }
  .lg-n { font-family: var(--mono); font-size: clamp(26px, 3.6vw, 34px); font-weight: 600; letter-spacing: -0.03em; color: var(--text); order: 2; line-height: 1.1; }
  .lg-cell.lg-crit .lg-n { color: var(--crit-ink); }
  .lg-cell .regla { order: 3; margin-top: 8px; }

  .hero-cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; align-items: center; }

  .shead { max-width: 60ch; margin-bottom: 48px; }
  .shead h2 { font-size: clamp(26px, 3vw, 34px); }
  .shead p { margin-top: 16px; }

  /* Statband: la lectura del instrumento a página completa. */
  .statband { padding-block: clamp(48px, 7vw, 84px); border-block: 1px solid var(--line); background: var(--surface); }
  .sb-grid { display: grid; grid-template-columns: minmax(240px, 0.9fr) 1.1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  @media (max-width: 860px) { .sb-grid { grid-template-columns: 1fr; gap: 28px; } }
  .sb-num { font-family: var(--mono); font-weight: 600; font-size: clamp(84px, 12vw, 148px); line-height: 0.9; letter-spacing: -0.05em; color: var(--crit-ink); }
  .sb-num small { font-size: 0.36em; color: var(--faint); font-weight: 400; letter-spacing: 0; }
  .sb-regla { margin-top: 22px; height: 32px; }
  .sb-regla .aguja { height: 26px; }
  .sb-scale { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; color: var(--faint); margin-top: 6px; }
  .sb-claim .big { font-family: var(--display); font-variation-settings: "wdth" 116; font-size: clamp(22px, 2.8vw, 30px); font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; text-wrap: balance; }
  .sb-claim .big em { color: var(--crit-ink); font-style: normal; }
  .sb-claim .src { font-family: var(--mono); font-size: 12px; color: var(--faint); margin-top: 18px; letter-spacing: 0.04em; }

  /* Pilares: índice de filas con regla — lenguaje de informe, no feature-grid. */
  .pillar-index { border-top: 1.5px solid var(--line-strong); }
  .pi-row { display: grid; grid-template-columns: 210px 220px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding: 26px 4px; border-bottom: 1px solid var(--line); color: inherit; transition: background-color .18s ease, padding-left .18s ease; }
  .pi-row:hover { background: var(--surface); padding-left: 12px; }
  .pi-name { font-size: 22px; margin: 0; }
  .pi-hook { color: var(--text); font-size: 14px; font-weight: 600; margin: 0; }
  .pi-desc { color: var(--muted); font-size: 14px; line-height: 1.55; margin: 0; }
  .pi-arrow { font-family: var(--mono); color: var(--faint); transition: color .18s ease, transform .18s ease; }
  .pi-row:hover .pi-arrow { color: var(--text); transform: translateX(3px); }
  @media (max-width: 860px) {
    .pi-row { grid-template-columns: 1fr auto; gap: 6px 16px; align-items: start; }
    .pi-name { grid-column: 1; }
    .pi-arrow { grid-column: 2; grid-row: 1; align-self: center; }
    .pi-hook, .pi-desc { grid-column: 1 / -1; }
    .pi-row:hover { padding-left: 4px; }
  }

  /* Método + Pricing fusionados en 2 columnas */
  .method-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  @media (max-width: 900px) { .method-grid { grid-template-columns: 1fr; gap: 64px; } }
  .method-col .shead { margin-bottom: 32px; }

  /* Pasos con ordinal mono (secuencia genuina) — sin iconos decorativos. */
  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .timeline li { display: flex; gap: 20px; padding-block: 20px; border-bottom: 1px solid var(--line-soft); }
  .timeline li:last-child { border-bottom: none; }
  .step-n { font-family: var(--mono); font-size: 15px; font-weight: 600; color: var(--crit-ink); flex: none; padding-top: 2px; min-width: 34px; }
  .timeline .sn { font-family: var(--display); font-variation-settings: "wdth" 116; font-size: 17px; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .timeline p { color: var(--muted); font-size: 14px; margin-top: 5px; line-height: 1.55; }

  .ladder-v { display: flex; flex-direction: column; gap: 12px; }
  .rung-v { background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius-sm); padding: 18px 22px; transition: border-color .2s, transform .2s; }
  .rung-v:hover { border-color: var(--crit); transform: translateX(3px); }
  .rung-v.free { border-color: color-mix(in srgb, var(--crit) 45%, transparent); }
  .rv-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .rung-v .lvl { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: 0.12em; text-transform: uppercase; }
  .rung-v .kind { font-family: var(--mono); font-size: 10.5px; color: var(--ok-ink); border: 1px solid var(--line); border-radius: 3px; padding: 3px 9px; letter-spacing: 0.05em; text-transform: uppercase; }
  .rung-v.free .kind { background: var(--ok); color: var(--lime-fg); border-color: transparent; }
  .rung-v h3 { font-size: 18px; }
  .rung-v .for { color: var(--muted); font-size: 13.5px; margin-top: 6px; line-height: 1.5; }

  /* Quién firma el informe: la credencial real, con cara. */
  .firma { border-top: 1px solid var(--line); padding-block: clamp(56px, 8vw, 88px); }
  .firma-grid { display: grid; grid-template-columns: minmax(200px, 300px) 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 720px) { .firma-grid { grid-template-columns: 1fr; gap: 28px; } .firma-foto { max-width: 240px; } }
