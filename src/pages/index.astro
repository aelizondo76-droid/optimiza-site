---
import Base from '../layouts/Base.astro';
import Scanner from '../components/Scanner.astro';
import { getSeo } from '../lib/seo';
import { founderProgramSlots } from '../lib/founderProgram';
const founder = founderProgramSlots();
const seo = await getSeo('home', {
  title: 'Optimiza — Optimización de negocios a través de tu web',
  description: 'No solo optimizamos tu web: optimizamos tu negocio a través de ella. Analiza tu sitio al instante y descubre dónde pierdes ventas — y cuánto puedes recuperar.',
});
const title = seo.title;
const description = seo.description;

// AEO: mismas preguntas/respuestas visibles en la sección #faq, también expuestas como FAQPage.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Son nuevos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí, y lo decimos de frente. Por eso ofrecemos garantía de desempeño y un cupo fundador con precio preferente. Preferimos demostrar antes que presumir: nuestro escáner y nuestro propio sitio hablan por nosotros.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto cuesta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El diagnóstico es gratis. A partir de ahí, cada nivel tiene un precio claro según el alcance — Cimientos es un proyecto puntual, Aceleración y Autopilot son mensuales. Sin sorpresas ni letras chiquitas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Trabajan con mi plataforma?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí: WordPress, Shopify, Webflow, sitios a medida y más. El diagnóstico detecta tu stack automáticamente y adaptamos el plan a lo que ya tienes.',
      },
    },
  ],
};
---
<Base title={title} description={description} ogImage={seo.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="hero section hero-data dark">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Índice Optimiza · Costa Rica 2026</p>
          <h1 class="hero-title">Tu competidor que empiece a medir su web, te va a vencer.</h1>
          <p class="hero-lead">No importará su tamaño. Importará su estrategia web. Analiza la tuya ahora mismo — el mismo escáner que usamos para medir 386 empresas costarricenses.</p>
          <div class="hero-cta-row">
            <a class="btn btn-ghost" href="#metodo">Ver cómo trabajamos</a>
          </div>
        </div>
        <div class="hero-instrument">
          <Scanner />
          <p class="hero-sub">Sin registro para ver tu puntaje · esto mismo acabas de correrlo sobre optimizahq.com.</p>
        </div>
      </div>

      <dl class="ledger-row" aria-label="Estado digital de las empresas en Costa Rica, 2026">
        <div class="lg-cell"><dt class="lg-l">sitios analizados</dt><dd class="lg-n">386</dd></div>
        <div class="lg-cell lg-warn"><dt class="lg-l">sin Meta Pixel</dt><dd class="lg-n">88%</dd></div>
        <div class="lg-cell lg-crit"><dt class="lg-l">pérdida anual estimada</dt><dd class="lg-n">$122M</dd></div>
      </dl>
    </div>
  </section>

  <section class="section statband">
    <div class="wrap">
      <p class="big">El 88% de las empresas no puede ver quién visita su web, ni volver a contactarlo. <em>Eso es lo que de verdad cuesta ventas</em> — no un segundo más de carga.</p>
      <p class="src">Fuente: Índice Optimiza · 386 sitios analizados, Costa Rica 2026</p>
    </div>
  </section>

  <section class="section" id="pilares">
    <div class="wrap">
      <div class="shead">
        <h2>Todo lo que tu web necesita para vender, en un solo lugar.</h2>
        <p class="lead">Nuestra optimización web se apoya en cuatro palancas que trabajan juntas: atraer, cargar rápido, convertir y automatizar. No vendemos tareas técnicas — vendemos el resultado de negocio de cada una.</p>
      </div>
      <div class="pillar-index">
        <a class="pi-row" href="/servicios/#velocidad">
          <h3 class="pi-name">Velocidad</h3>
          <p class="pi-hook">&ldquo;Cada segundo cuesta ventas.&rdquo;</p>
          <p class="pi-desc">Core Web Vitals, compresión de imágenes y código limpio para que tu web cargue al instante.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#visibilidad">
          <h3 class="pi-name">Visibilidad</h3>
          <p class="pi-hook">&ldquo;Que te encuentren primero.&rdquo;</p>
          <p class="pi-desc">SEO técnico, contenido y optimización para IA — para que aparezcas antes que tu competencia.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#conversion">
          <h3 class="pi-name">Conversión</h3>
          <p class="pi-hook">&ldquo;Convierte tráfico en clientes.&rdquo;</p>
          <p class="pi-desc">Landing pages, medición y pruebas A/B para que las visitas que ya tienes se vuelvan ventas.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pi-row" href="/servicios/#automatizacion">
          <h3 class="pi-name">Automatización</h3>
          <p class="pi-hook">&ldquo;Que tu negocio trabaje sin ti.&rdquo;</p>
          <p class="pi-desc">CRM, integraciones y flujos que convierten tu crecimiento en tiempo libre recuperado.</p>
          <span class="pi-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="metodo">
    <div class="wrap">
      <div class="method-grid">
        <div class="method-col">
          <div class="shead">
            <h2>Sin cajas negras.</h2>
            <p class="lead">Un proceso claro, en cuatro pasos, donde cada acción se justifica por su impacto en ventas — no por horas facturadas.</p>
          </div>
          <ol class="timeline">
            <li><span class="step-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg></span><div><div class="sn">01 · Diagnosticamos</div><p>Auditoría técnica completa de velocidad, SEO y conversión.</p></div></li>
            <li><span class="step-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg></span><div><div class="sn">02 · Priorizamos</div><p>Ordenamos cada mejora por impacto en tus ventas, no por dificultad.</p></div></li>
            <li><span class="step-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg></span><div><div class="sn">03 · Ejecutamos</div><p>Implementamos rápido, con reportes claros en cada paso.</p></div></li>
            <li><span class="step-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span><div><div class="sn">04 · Medimos</div><p>Reportamos resultados en la métrica que importa: dinero.</p></div></li>
          </ol>
        </div>

        <div class="method-col" id="paquetes">
          <div class="shead">
            <h2>Empieza donde estás. Escala cuando estés listo.</h2>
            <p class="lead">Una escalera clara: entra por un diagnóstico gratis y sube de nivel solo cuando el anterior ya te esté generando resultados.</p>
          </div>
          <div class="ladder-v">
            <article class="rung-v free"><div class="rv-top"><span class="lvl">Paso 0</span><span class="kind">Gratis</span></div><h3>Diagnóstico</h3><p class="for">Descubre qué te frena y cuánto puedes ganar.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 1</span><span class="kind">Proyecto</span></div><h3>Cimientos</h3><p class="for">Para que tu web deje de perder ventas: base técnica sólida.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 2</span><span class="kind">Retainer</span></div><h3>Aceleración</h3><p class="for">Para crecer ventas mes a mes: tráfico y conversión.</p></article>
            <article class="rung-v"><div class="rv-top"><span class="lvl">Nivel 3</span><span class="kind">Premium</span></div><h3>Autopilot</h3><p class="for">Para que el crecimiento no dependa de ti: automatización total.</p></article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(80px,11vw,130px)">
    <div class="wrap">
      <div class="founder-band dark">
        <div class="fb-grid">
          <div>
            <h2 style="font-size:clamp(26px,4vw,40px)">5 empresas. Precio de fundador. Resultados garantizados.</h2>
            <p class="lead" style="margin-top:14px">Buscamos cinco negocios en crecimiento para trabajar de cerca a cambio de precio preferente y un caso de éxito compartido. Entra temprano en algo bueno.</p>
            <div class="fb-slots" aria-hidden="true" set:html={founder.dotsHtml} />
            <p class="fb-count">{founder.label}</p>
            <div class="hero-cta-row"><a class="btn btn-lime" href="/contacto/">Aplicar al Programa Fundador</a></div>
          </div>
          <div class="fb-guarantee">
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Precio fundador, congelado mientras seas cliente.</span></div>
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Sin amarres: mes a mes, cancelas cuando quieras.</span></div>
            <div class="g"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12 l5 5 9-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Atención directa del fundador, no de un becario.</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section closer" id="faq">
    <div class="wrap">
      <div class="closer-grid">
        <div>
          <h2>Lo que probablemente te estás preguntando.</h2>
          <div class="faq">
            <div class="qa"><button class="q" aria-expanded="false">¿Son nuevos?<span class="ic" aria-hidden="true"></span></button><div class="a"><p>Sí, y lo decimos de frente. Por eso ofrecemos garantía de desempeño y un cupo fundador con precio preferente. Preferimos demostrar antes que presumir: nuestro escáner y nuestro propio sitio hablan por nosotros.</p></div></div>
            <div class="qa"><button class="q" aria-expanded="false">¿Cuánto cuesta?<span class="ic" aria-hidden="true"></span></button><div class="a"><p>El diagnóstico es gratis. A partir de ahí, cada nivel tiene un precio claro según el alcance — Cimientos es un proyecto puntual, Aceleración y Autopilot son mensuales. Sin sorpresas ni letras chiquitas.</p></div></div>
            <div class="qa"><button class="q" aria-expanded="false">¿Trabajan con mi plataforma?<span class="ic" aria-hidden="true"></span></button><div class="a"><p>Sí: WordPress, Shopify, Webflow, sitios a medida y más. El diagnóstico detecta tu stack automáticamente y adaptamos el plan a lo que ya tienes.</p></div></div>
          </div>
        </div>

        <div class="closer-cta">
          <h2>¿Listo para ver cuánto puede crecer tu web?</h2>
          <div class="cta-row">
            <a class="btn btn-lime" href="#scanner">Analizar mi web gratis</a>
            <a class="btn btn-ghost" href="/contacto/">Agenda una llamada</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-data { overflow: hidden; }
  /* Sesgo deliberado: copy a la izquierda, instrumento a la derecha — nada centrado. */
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (max-width: 940px) { .hero-grid { grid-template-columns: 1fr; gap: 36px; } }
  h1.hero-title { font-family: var(--mono); font-weight: 700; letter-spacing: -0.02em; font-size: clamp(27px, 3.2vw, 38px); margin-bottom: 18px; line-height: 1.22; overflow-wrap: anywhere; min-width: 0; }
  .hero-lead { color: var(--muted); font-size: clamp(15.5px, 1.6vw, 17px); max-width: 46ch; }
  .hero-instrument { min-width: 0; }
  .hero-sub { font-size: 12.5px; color: var(--faint); margin-top: 12px; }

  /* Ledger: fila de datos, no tarjetas flotantes — la prueba se lee como un renglón de reporte. */
  .ledger-row { display: flex; flex-wrap: wrap; gap: 0; margin: clamp(40px, 6vw, 64px) 0 0; border-top: 1px solid rgba(255,255,255,0.14); border-bottom: 1px solid rgba(255,255,255,0.14); }
  .lg-cell { flex: 1; min-width: 160px; padding: 20px 24px 20px 0; display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 6px; border-left: 1px solid rgba(255,255,255,0.14); }
  .lg-cell + .lg-cell { padding-left: 24px; }
  .lg-cell:first-child { border-left: none; }
  @media (max-width: 560px) { .lg-cell { border-left: none; border-top: 1px solid rgba(255,255,255,0.14); } .lg-cell:first-child { border-top: none; } }
  .lg-cell dt, .lg-cell dd { margin: 0; }
  .lg-n { font-family: var(--mono); font-size: clamp(24px, 3.6vw, 32px); font-weight: 700; letter-spacing: -0.02em; color: var(--text); }
  .lg-cell.lg-warn .lg-n { color: var(--violet-ink); }
  .lg-cell.lg-crit .lg-n { color: var(--violet-ink); }
  .lg-l { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: 0.04em; }

  .hero-cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; align-items: center; }

  .shead { max-width: 60ch; margin-bottom: 48px; }
  .shead h2 { font-size: clamp(26px, 3vw, 34px); }
  .shead p { margin-top: 16px; }

  .statband { text-align: center; padding-block: clamp(40px, 6vw, 64px); }
  .statband .big { font-size: clamp(30px, 5vw, 52px); font-weight: 700; letter-spacing: -0.03em; max-width: 20ch; margin-inline: auto; }
  .statband .big em { color: var(--violet-ink); font-style: normal; }
  .statband .src { font-family: var(--mono); font-size: 12px; color: var(--faint); margin-top: 20px; letter-spacing: 0.06em; }

  /* Pilares: índice de filas con regla — lenguaje de informe, no feature-grid. */
  .pillar-index { border-top: 1px solid var(--line); }
  .pi-row { display: grid; grid-template-columns: 200px 220px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding: 26px 4px; border-bottom: 1px solid var(--line); color: inherit; transition: background-color .18s ease, padding-left .18s ease; }
  .pi-row:hover { background: var(--surface); padding-left: 12px; }
  .pi-name { font-size: 21px; letter-spacing: -0.02em; margin: 0; }
  .pi-hook { color: var(--text); font-size: 14px; font-weight: 600; margin: 0; }
  .pi-desc { color: var(--muted); font-size: 14px; line-height: 1.55; margin: 0; }
  .pi-arrow { font-family: var(--mono); color: var(--faint); transition: color .18s ease, transform .18s ease; }
  .pi-row:hover .pi-arrow { color: var(--text); transform: translateX(3px); }
  @media (max-width: 860px) {
    .pi-row { grid-template-columns: 1fr auto; gap: 6px 16px; align-items: start; }
    .pi-name { grid-column: 1; }
    .pi-arrow { grid-column: 2; grid-row: 1; align-self: center; }
    .pi-hook, .pi-desc { grid-column: 1 / -1; }
    .pi-row:hover { padding-left: 4px; }
  }

  /* Método + Pricing fusionados en 2 columnas */
  .method-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  @media (max-width: 900px) { .method-grid { grid-template-columns: 1fr; gap: 64px; } }
  .method-col .shead { margin-bottom: 32px; }

  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .timeline li { display: flex; gap: 18px; padding-block: 18px; border-left: 2px solid var(--line); padding-left: 22px; margin-left: 20px; position: relative; }
  .timeline li:last-child { border-left-color: transparent; }
  .step-ic { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--line); color: var(--text); flex: none; margin-left: -41px; margin-top: -2px; }
  .step-ic svg { width: 18px; height: 18px; }
  .timeline .sn { font-family: var(--mono); font-size: 12px; color: var(--cyan-ink); letter-spacing: 0.1em; font-weight: 600; text-transform: uppercase; }
  .timeline p { color: var(--muted); font-size: 13.5px; margin-top: 6px; line-height: 1.5; }

  .ladder-v { display: flex; flex-direction: column; gap: 12px; }
  .rung-v { background: var(--surface); border: 1px solid var(--line-soft); border-radius: 14px; padding: 18px 22px; box-shadow: var(--card-shadow); transition: border-color .2s, transform .2s; }
  .rung-v:hover { border-color: var(--violet); transform: translateX(3px); }
  .rung-v.free { border-color: color-mix(in srgb, var(--violet) 45%, transparent); }
  .rv-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .rung-v .lvl { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: 0.14em; text-transform: uppercase; }
  .rung-v .kind { font-family: var(--mono); font-size: 10.5px; color: var(--cyan-ink); border: 1px solid var(--line); border-radius: 99px; padding: 3px 10px; letter-spacing: 0.05em; }
  .rung-v.free .kind { background: var(--lime); color: var(--lime-fg); border-color: transparent; }
  .rung-v h3 { font-size: 18px; }
  .rung-v .for { color: var(--muted); font-size: 13.5px; margin-top: 6px; line-height: 1.5; }

  .founder-band { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 52px); position: relative; overflow: hidden; }
  .founder-band.dark { background: var(--ink-2, #0A0B0C); }
  .fb-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; align-items: center; position: relative; z-index: 1; }
  @media (max-width: 780px) { .fb-grid { grid-template-columns: 1fr; gap: 26px; } }
  .fb-slots { display: flex; gap: 8px; margin: 22px 0; }
  .slot { flex: 1; height: 6px; border-radius: 99px; background: var(--violet); }
  .slot.taken { background: rgba(255,255,255,0.12); }
  .fb-count { font-family: var(--mono); font-size: 12px; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
  .fb-guarantee { display: flex; flex-direction: column; gap: 14px; }
  .fb-guarantee .g { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; color: var(--text); }
  .fb-guarantee .g svg { color: var(--lime); flex: none; margin-top: 2px; }

  /* FAQ + CTA final fusionados */
  .closer-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(40px, 6vw, 72px); align-items: start; }
  @media (max-width: 900px) { .closer-grid { grid-template-columns: 1fr; gap: 56px; } }
  .closer h2 { font-size: clamp(26px, 3.6vw, 38px); margin-top: 10px; }
  .faq { margin-top: 32px; }
  .qa { border-bottom: 1px solid var(--line); }
  .qa button.q { width: 100%; background: none; border: 0; color: var(--text); font-family: var(--sans); font-size: 16px; font-weight: 600; text-align: left; padding: 20px 36px 20px 0; cursor: pointer; position: relative; letter-spacing: -0.01em; }
  .qa button.q .ic { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: 17px; font-weight: 700; color: var(--faint); }
  .qa button.q .ic::before { content: "+"; }
  .qa.open button.q .ic::before { content: "\2212"; }
  .qa.open button.q .ic { color: var(--text); }
  .qa .a { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
  .qa .a p { color: var(--muted); font-size: 14.5px; line-height: 1.6; padding: 0 36px 20px 0; }

  .closer-cta { background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius-lg); padding: 32px; box-shadow: var(--card-shadow); }
  .closer-cta h2 { margin-top: 0; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
</style>
