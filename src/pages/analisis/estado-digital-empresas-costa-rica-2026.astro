  .art-cta p { color: var(--muted); margin: 0 0 16px; }
  .btn { display: inline-block; padding: 12px 28px; border-radius: 8px; font-weight: 600; text-decoration: none; background: var(--lime); color: var(--lime-fg); transition: transform .2s ease, box-shadow .2s ease; }
